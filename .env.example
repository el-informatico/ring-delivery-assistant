# ring-delivery-assistant — configuration contract.
# Copy to .env (gitignored) and fill in real values. Never commit .env.

# --- Webhook ingestion ------------------------------------------------------

# Shared secret for HMAC-SHA256 webhook signature verification.
# The signature header carries: sha256=<hex digest of the raw body>.
# REQUIRED in production; tests and the demo pass their own synthetic key.
RING_WEBHOOK_SECRET=

# Header that carries the signature (lowercase). The value below is the
# LIVE Ring header: "X-Signature: sha256=<hex HMAC-SHA256 of the raw body>"
# (webhook docs: Webhook Authentication & Verification). The library's
# internal default stays x-ring-signature (tests, demo, flat-payload
# replay) — the served app reads this setting, so live traffic needs it.
RING_SIGNATURE_HEADER=x-signature

# --- Ring app credentials (registration gate; OAuth work is S2) --------------

# From the Ring Developer Portal credentials screen — shown ONCE, no
# regenerate. Not needed by anything offline; paste them here when the
# registration gate (docs/REGISTRATION-GUIDE.md) completes. Never chat,
# never commit — .env is the only home.
RING_CLIENT_ID=
RING_CLIENT_SECRET=

# --- Intent classifier (optional) -------------------------------------------

# Leave RING_LLM_ENDPOINT empty to use the deterministic rules stub
# (fully offline). Set it to an OpenAI-compatible chat-completions
# endpoint for the multimodal adapter, e.g. a local vision server or a
# hosted API. The adapter sends the snapshot as a base64 data URI.
RING_LLM_ENDPOINT=
RING_LLM_MODEL=
# Optional: only when the endpoint requires a bearer token. Never hardcode.
RING_LLM_API_KEY=
RING_LLM_TIMEOUT=20

# --- Routing ----------------------------------------------------------------

# Generic webhook sink: when set, every delivered notification is POSTed
# as JSON to this URL. Empty = disabled (LogSink still records locally).
RING_NOTIFY_WEBHOOK_URL=

# "Night" window (UTC hours in this skeleton) for the escalation rule
# "person at the door at night". start inclusive, end exclusive.
RING_NIGHT_START=21
RING_NIGHT_END=6

# Motion-noise suppression: suppress motion-only events unless this many
# occur within this many minutes (then send ONE digest notification).
RING_MOTION_BURST_COUNT=3
RING_MOTION_BURST_WINDOW_MIN=10

# --- Persistence ------------------------------------------------------------

# SQLite database file for the event log and derived package tracks.
RING_DB_PATH=ring-assistant.db
