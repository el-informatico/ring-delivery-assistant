# ring-delivery-assistant — configuration contract.
# Copy to .env (gitignored) and fill in real values. Never commit .env.

# --- Webhook ingestion ------------------------------------------------------

# Shared secret for HMAC-SHA256 webhook signature verification.
# The signature header carries: sha256=<hex digest of the raw body>.
# REQUIRED in production; tests and the demo pass their own synthetic key.
RING_WEBHOOK_SECRET=

# Header that carries the signature (lowercase). The value below is the
# LIVE Ring header: "X-Signature: sha256=<hex HMAC-SHA256 of the raw body>"
# (webhook docs: Webhook Authentication & Verification). The library's
# internal default stays x-ring-signature (tests, demo, flat-payload
# replay) — the served app reads this setting, so live traffic needs it.
RING_SIGNATURE_HEADER=x-signature

# --- Ring app credentials (S2 OAuth token exchange) ---------------------------

# From the Ring Developer Portal credentials screen — shown ONCE, no
# regenerate. With both set, the served /oauth/callback exchanges the
# authorization code Ring POSTs there against oauth.ring.com (docs §5:
# one-time code, 60 s lifetime, form-urlencoded, client-secret
# confidential client — no PKCE), and `uv run mint-token <code>` does
# the same by hand. Never chat, never commit — .env is the only home.
RING_CLIENT_ID=
RING_CLIENT_SECRET=

# Where a successful exchange persists its token bundle (access +
# refresh + expiry) as owner-only JSON. The access token from that file
# is what you paste as RING_API_TOKEN below. Empty = bundle is not
# persisted. If set, gitignore the path.
RING_TOKEN_STORE=

# --- Intent classifier (optional) -------------------------------------------

# Leave RING_LLM_ENDPOINT empty to use the deterministic rules stub
# (fully offline). Set it to an OpenAI-compatible chat-completions
# endpoint for the multimodal adapter, e.g. a local vision server or a
# hosted API. The adapter sends the snapshot as a base64 data URI.
RING_LLM_ENDPOINT=
RING_LLM_MODEL=
# Optional: only when the endpoint requires a bearer token. Never hardcode.
RING_LLM_API_KEY=
RING_LLM_TIMEOUT=20

# --- Routing ----------------------------------------------------------------

# Generic webhook sink: when set, every delivered notification is POSTed
# as JSON to this URL. Empty = disabled (LogSink still records locally).
RING_NOTIFY_WEBHOOK_URL=

# Telegram sink (the routed-notification sink a phone sees). To enable:
#   1. Talk to @BotFather in Telegram -> /newbot -> copy the bot token.
#   2. Send your bot any message (or add it to a group and message there).
#   3. Look up the numeric chat id (any "getUpdates" walkthrough; for a
#      group chat it is negative).
#   4. Paste both values here — .env is gitignored; never chat, never commit.
# Empty = sink not wired: offline CLIs run the same sink over a recording
# mock transport instead, and the served app simply delivers without it.
# Severity is honored: critical notifications arrive with sound, info ones
# arrive silent (Telegram disable_notification).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TIMEOUT=10

# "Night" window (UTC hours in this skeleton) for the escalation rule
# "person at the door at night". start inclusive, end exclusive.
RING_NIGHT_START=21
RING_NIGHT_END=6

# Motion-noise suppression: suppress motion-only events unless this many
# occur within this many minutes (then send ONE digest notification).
RING_MOTION_BURST_COUNT=3
RING_MOTION_BURST_WINDOW_MIN=10

# --- Persistence ------------------------------------------------------------

# SQLite database file for the event log and derived package tracks.
RING_DB_PATH=ring-assistant.db

# --- Real ingestion (S2; all optional — empty = offline mode) ----------------

# Directory for the webhook capture. When set, the served app records
# EVERY delivery to <dir>/webhooks.jsonl (body, headers, outcome,
# status) — exactly the file `uv run replay-webhooks` consumes.
# Captures hold no secrets: bodies and metadata only; replay re-signs
# with the local secret.
RING_RECORD_DIR=

# Events API (event history + image snapshots), as documented at
# https://api.amazonvision.com. Override only for tests against a mock.
RING_API_BASE_URL=https://api.amazonvision.com

# Bearer token for the Events API. MINTED by the token exchange above
# (server /oauth/callback or `uv run mint-token`): copy the access
# token from the RING_TOKEN_STORE file here once an exchange succeeds.
# When set, snapshot fetching goes live (ApiSnapshotSource). Access
# tokens live ~4 h — refresh with `uv run mint-token --refresh` and
# re-paste. Paste-into-.env only — never chat, never commit.
RING_API_TOKEN=

# Per-request timeout (seconds) for Events API calls.
RING_API_TIMEOUT=10
